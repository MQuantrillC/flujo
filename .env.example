# Copia este archivo a .env en la máquina donde corre Flujo.

# Dominio para HTTPS automático (deja vacío si entras por IP).
FLUJO_DOMINIO=

# Pon 1 sólo si entras por IP sin HTTPS; si no, la sesión no se guarda.
FLUJO_SIN_HTTPS=0

# ── Correos: invitaciones y avisos (opcional) ───────────────────────────────
# Sin SMTP ni Resend, Flujo no manda correos: en Ajustes hay un botón para
# copiar el enlace de invitación y pasarlo a mano.
#
# Opción A, sin dominio: una cuenta de Gmail. SMTP_CLAVE es una «contraseña de
# aplicación» (myaccount.google.com/apppasswords, exige verificación en dos
# pasos), no la contraseña normal. Si están las dos, gana sobre Resend.
SMTP_USUARIO=
SMTP_CLAVE=
# Opcionales: otro servidor SMTP (por omisión smtp.gmail.com, puerto 465).
SMTP_HOST=
SMTP_PUERTO=
#
# Opción B, con dominio verificado en Resend:
# Clave de Resend (https://resend.com/api-keys). Sólo aquí, nunca en el repo.
RESEND_API_KEY=
# De quién salen los correos. El dominio debe estar verificado en Resend
# (Domains). Vacío = "Flujo <onboarding@resend.dev>", que sólo llega al
# correo dueño de la cuenta de Resend (sirve para probar).
FLUJO_REMITENTE=
# Dirección pública de la app para los enlaces, ej. https://flujo.xertica.com.
# Vacío = se toma de la petición.
FLUJO_URL=
